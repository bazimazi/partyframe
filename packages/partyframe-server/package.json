{
  "name": "@bazimazi/partyframe-server",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Authoritative party-game server: sessions, room codes, lobby, bots, reconnection and the PartyGame rules contract, on Colyseus.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazimazi/party-frame.git",
    "directory": "packages/partyframe-server"
  },
  "homepage": "https://github.com/bazimazi/party-frame#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@standard-schema/spec": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@partyframe/game-core": "0.2.0",
    "@partyframe/protocol": "0.2.0",
    "@types/node": "24.13.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "party-game",
    "multiplayer",
    "colyseus",
    "game-server",
    "websocket",
    "jackbox"
  ],
  "engines": {
    "node": ">=20.11"
  }
}
