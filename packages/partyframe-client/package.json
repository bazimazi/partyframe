{
  "name": "@bazimazi/partyframe-client",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "React shells for the shared screen and phone controllers of a partyframe game, with session client, clock sync, sound and an optional Phaser stage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazimazi/party-frame.git",
    "directory": "packages/partyframe-client"
  },
  "homepage": "https://github.com/bazimazi/party-frame#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "colyseus.js": "^0.16.22",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "phaser": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@partyframe/i18n": "0.2.0",
    "@partyframe/protocol": "0.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "files": [
    "dist",
    "styles.css",
    "fonts.css",
    "README.md"
  ],
  "keywords": [
    "party-game",
    "multiplayer",
    "react",
    "phaser",
    "controller",
    "colyseus",
    "jackbox"
  ]
}
